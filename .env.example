# CLIR FE 환경 변수 템플릿. 실제 값으로 채워 .env 로 복사.
# .env 는 .gitignore 에 등록됨 — 절대 commit 금지.

# ─── BE / Auth (필수) ────────────────────────────────────────────────────────

# Railway 프로덕션 BE URL
EXPO_PUBLIC_API_BASE_URL=https://focused-imagination-production-49c9.up.railway.app

# Supabase 프로젝트 URL + anon key (RLS 적용된 공개 키)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── 관측성 (선택, 베타 권장) ────────────────────────────────────────────────

# Sentry DSN — 미설정 시 SDK 가 no-op. production 빌드의 크래시 리포팅 권장.
# https://sentry.io → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Sentry source map 자동 업로드용 (EAS Build 시점에만 사용 — 클라이언트 번들에 박히지 않음).
# EXPO_PUBLIC_ 접두사 금지. AUTH_TOKEN 은 Sentry → User Auth Tokens 에서 발급.
# scopes: project:read, project:releases, org:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
